function pull_image_from_video () {
  if (($# == 0)); then
    echo "Usage: pull_image_from_video <filename>"
  else
    ffmpeg -loglevel error -i "$1" -vframes 1 -update 1 "${1:r}.jpg"
  fi
}

function remove_ascii_colors () {
  if (($# == 0)); then
    echo "Usage: remove_ascii_colors <filename>"
  else
    cat $1 | sed -r "s/\x1B\[([0-9]{1,2}(;[0-9]{1,2})?)?[mGK]//g" > "cleaned_$1"
  fi
}

function unlock_drives() {
  echo "🔓 Unlocking encrypted APFS volumes...\n"

  # Array of volumes to unlock (disk identifier, name)
  local volumes=(
    "disk7s1:Backup 1TB"
    "disk9s1:Storage"
    "disk10s1:Attic"
  )

  for volume_info in "${volumes[@]}"; do
    local disk="${volume_info%%:*}"
    local name="${volume_info##*:}"

    # Check if volume is already unlocked
    if diskutil apfs list | grep -A 10 "$disk" | grep -q "FileVault:.*Yes (Unlocked)"; then
      echo "✓ $name ($disk) is already unlocked"
    else
      echo "\n📀 Unlocking $name ($disk)..."
      diskutil apfs unlockVolume "$disk"

      if [ $? -eq 0 ]; then
        echo "✓ Successfully unlocked $name"
      else
        echo "✗ Failed to unlock $name"
      fi
    fi
  done

  echo "\n✅ Done!"
}

